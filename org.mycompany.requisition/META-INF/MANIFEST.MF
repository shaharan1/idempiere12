Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Requisition
Bundle-SymbolicName: org.mycompany.requisition;singleton:=true
Bundle-Version: 1.0.0.qualifier
Fragment-Host: org.adempiere.base
Bundle-ActivationPolicy: lazy
Require-Bundle: org.adempiere.ui.zk;bundle-version="12.0.0";resolution:=optional,
 org.adempiere.ui;bundle-version="12.0.0";resolution:=optional,
 org.adempiere.report.jasper;bundle-version="12.0.0";resolution:=optional,
 net.sf.jasperreports.engine;bundle-version="6.0.0";resolution:=optional
Export-Package: org.mycompany.requisition,
 org.mycompany.requisition.callout,
 org.mycompany.requisition.event,
 org.mycompany.requisition.model,
 org.mycompany.requisition.process,
 org.mycompany.requisition.report,
 org.mycompany.requisition.rfq,
 org.mycompany.requisition.rfqapproval,
 org.mycompany.requisition.rfqpo,
 org.mycompany.requisition.rfqresponse,
 org.mycompany.requisition.rfqwinner,
 org.mycompany.requisition.service,
 org.mycompany.requisition.ui
Import-Package: org.osgi.service.event,
 org.zkoss.util.media,
 org.zkoss.zk.ui,
 org.zkoss.zk.ui.event,
 org.zkoss.zk.ui.util,
 org.zkoss.zul
Service-Component: OSGI-INF/org.mycompany.requisition.RequisitionFormFactory.xml,
 OSGI-INF/com.xx.approval.process.XXProcessFactory.xml,
 OSGI-INF/org.mycompany.requisition.callout.CalloutRfQRequisition.xml,
 OSGI-INF/org.mycompany.requisition.process.SubmitRfQProcess.xml,
