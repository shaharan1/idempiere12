<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GoodsReceipt" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
<parameter name="IDS" class="java.lang.String"><defaultValueExpression><![CDATA["0"]]></defaultValueExpression></parameter>
<parameter name="LOGO_LEFT" class="java.lang.String"><defaultValueExpression><![CDATA["C:/jasper/logo_left.png"]]></defaultValueExpression></parameter>
<parameter name="LOGO_RIGHT" class="java.lang.String"><defaultValueExpression><![CDATA["C:/jasper/logo_right.png"]]></defaultValueExpression></parameter>
<queryString><![CDATA[SELECT io.m_inout_id, io.documentno AS grn_no, io.movementdate AS movement_date,
 o.documentno AS po_no, o.dateordered AS po_date, bp.name AS supplier, w.name AS warehouse,
 io.poreference AS challan, dt.name AS doc_type,
 (SELECT sl.name FROM ad_ref_list sl WHERE sl.ad_reference_id=131 AND sl.value=io.docstatus LIMIT 1) AS status,
 io.description AS note, u.name AS prepared_by, io.created AS prepared_date,
 l.line AS line_no, p.value AS item_code, p.name AS item_name, uom.uomsymbol AS uom,
 ol.qtyordered AS ordered, l.movementqty AS received, lo.value AS locator, l.description AS remarks
FROM m_inout io
JOIN m_inoutline l ON l.m_inout_id=io.m_inout_id AND l.isactive='Y'
LEFT JOIN c_order o ON o.c_order_id=io.c_order_id
LEFT JOIN c_orderline ol ON ol.c_orderline_id=l.c_orderline_id
LEFT JOIN c_bpartner bp ON bp.c_bpartner_id=io.c_bpartner_id
LEFT JOIN m_warehouse w ON w.m_warehouse_id=io.m_warehouse_id
LEFT JOIN c_doctype dt ON dt.c_doctype_id=io.c_doctype_id
LEFT JOIN ad_user u ON u.ad_user_id=io.createdby
LEFT JOIN m_product p ON p.m_product_id=l.m_product_id
LEFT JOIN c_uom uom ON uom.c_uom_id=COALESCE(l.c_uom_id,p.c_uom_id)
LEFT JOIN m_locator lo ON lo.m_locator_id=l.m_locator_id
WHERE io.m_inout_id IN ($P!{IDS})
ORDER BY io.documentno, l.line]]></queryString>
<field name="grn_no" class="java.lang.String"/>
<field name="movement_date" class="java.sql.Timestamp"/>
<field name="po_no" class="java.lang.String"/>
<field name="po_date" class="java.sql.Timestamp"/>
<field name="supplier" class="java.lang.String"/>
<field name="warehouse" class="java.lang.String"/>
<field name="challan" class="java.lang.String"/>
<field name="doc_type" class="java.lang.String"/>
<field name="status" class="java.lang.String"/>
<field name="note" class="java.lang.String"/>
<field name="prepared_by" class="java.lang.String"/>
<field name="prepared_date" class="java.sql.Timestamp"/>
<field name="m_inout_id" class="java.lang.Integer"/>
<field name="line_no" class="java.lang.Integer"/>
<field name="item_code" class="java.lang.String"/>
<field name="item_name" class="java.lang.String"/>
<field name="uom" class="java.lang.String"/>
<field name="ordered" class="java.math.BigDecimal"/>
<field name="received" class="java.math.BigDecimal"/>
<field name="locator" class="java.lang.String"/>
<field name="remarks" class="java.lang.String"/>
