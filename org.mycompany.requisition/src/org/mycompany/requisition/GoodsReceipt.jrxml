<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GoodsReceipt" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="22" bottomMargin="22">
<!--
  Goods Received Note (GRN). No SQL: the rows are handed over by WGoodsReceiptForm (data source built from the
  saved receipts through the model classes), one row per receipt line. One page (or more) per GRN.
  Parameters: LOGO_LEFT, LOGO_RIGHT (png path, blank when missing).
  Header : GRN No, GRN Date, Supplier, PO No, Organization, GRN Document, Warehouse / Locator, Challan / Supplier Ref. No,
           VAT Challan No / Date, Delivery Challan No / Date, Segment, Tolerance.
  Lines  : S/N, Item Code, Item Name, UOM, Ordered, Challan Qty, Received, Damaged, Accepted (Good), Rate, Receive Value,
           Net Cost / Unit, Status (Partial / Full / Complete / Over), Pack Size, No of Pack, Remarks (damage reason).
  Received = Accepted + Damaged. Receive Value = Rate x Received. Net Cost / Unit = Receive Value / Accepted.
-->
<style name="Zebra" mode="Opaque" backcolor="#FFFFFF"><conditionalStyle><conditionExpression><![CDATA[$V{GRN_COUNT}.intValue() % 2 == 0]]></conditionExpression><style backcolor="#F7F9FC"/></conditionalStyle></style>
<parameter name="LOGO_LEFT" class="java.lang.String"><defaultValueExpression><![CDATA["C:/jasper/logo_left.png"]]></defaultValueExpression></parameter>
<parameter name="LOGO_RIGHT" class="java.lang.String"><defaultValueExpression><![CDATA["C:/jasper/logo_right.png"]]></defaultValueExpression></parameter>
<field name="grn_id" class="java.lang.Integer"/>
<field name="grn_no" class="java.lang.String"/>
<field name="grn_date" class="java.sql.Timestamp"/>
<field name="org" class="java.lang.String"/>
<field name="doc_type" class="java.lang.String"/>
<field name="supplier" class="java.lang.String"/>
<field name="po_no" class="java.lang.String"/>
<field name="po_date" class="java.sql.Timestamp"/>
<field name="warehouse" class="java.lang.String"/>
<field name="ref_no" class="java.lang.String"/>
<field name="vat_no" class="java.lang.String"/>
<field name="vat_date" class="java.sql.Timestamp"/>
<field name="del_no" class="java.lang.String"/>
<field name="del_date" class="java.sql.Timestamp"/>
<field name="segment" class="java.lang.String"/>
<field name="tolerance" class="java.lang.String"/>
<field name="note" class="java.lang.String"/>
<field name="prepared_by" class="java.lang.String"/>
<field name="prepared_date" class="java.sql.Timestamp"/>
<field name="item_code" class="java.lang.String"/>
<field name="item_name" class="java.lang.String"/>
<field name="uom" class="java.lang.String"/>
<field name="ordered" class="java.math.BigDecimal"/>
<field name="challan_qty" class="java.math.BigDecimal"/>
<field name="received" class="java.math.BigDecimal"/>
<field name="damaged" class="java.math.BigDecimal"/>
<field name="accepted" class="java.math.BigDecimal"/>
<field name="rate" class="java.math.BigDecimal"/>
<field name="value" class="java.math.BigDecimal"/>
<field name="eff_cost" class="java.math.BigDecimal"/>
<field name="status" class="java.lang.String"/>
<field name="pack_size" class="java.lang.String"/>
<field name="no_of_pack" class="java.math.BigDecimal"/>
<field name="locator" class="java.lang.String"/>
<field name="remarks" class="java.lang.String"/>
<variable name="V_CH" class="java.math.BigDecimal" resetType="Group" resetGroup="GRN" calculation="Sum"><variableExpression><![CDATA[$F{challan_qty}]]></variableExpression></variable>
<variable name="V_RC" class="java.math.BigDecimal" resetType="Group" resetGroup="GRN" calculation="Sum"><variableExpression><![CDATA[$F{received}]]></variableExpression></variable>
<variable name="V_DM" class="java.math.BigDecimal" resetType="Group" resetGroup="GRN" calculation="Sum"><variableExpression><![CDATA[$F{damaged}]]></variableExpression></variable>
<variable name="V_VAL" class="java.math.BigDecimal" resetType="Group" resetGroup="GRN" calculation="Sum"><variableExpression><![CDATA[$F{value}]]></variableExpression></variable>
<variable name="V_AC" class="java.math.BigDecimal" resetType="Group" resetGroup="GRN" calculation="Sum"><variableExpression><![CDATA[$F{accepted}]]></variableExpression></variable>
<group name="GRN" isStartNewPage="true" isResetPageNumber="true" isReprintHeaderOnEachPage="true" minHeightToStartNewPage="140">
