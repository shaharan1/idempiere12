<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
	name="RequisitionForm" pageWidth="595" pageHeight="842" columnWidth="555"
	leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="14">

	<style name="Base" isDefault="true" fontName="SansSerif" fontSize="7"/>

	<parameter name="RECORD_ID" class="java.lang.Integer"/>

	<queryString>
		<![CDATA[SELECT r.DocumentNo AS documentno,
       r.RequisitionDate AS datedoc,
       r.DateRequired AS daterequired,
       r.Description AS note,
       COALESCE(rl.Name, r.DocStatus) AS status,
       o.Name AS department,
       r.PurchaseType AS purchasetype,
       w.Name AS deliverylocation,
       u.Name AS preparedby,
       u.Title AS preparedtitle,
       r.Created AS createdts,
       l.Line AS linenum,
       p.Value AS itemcode,
       p.Name AS itemname,
       uom.Name AS uom,
       l.Qty AS qty,
       st.qtyonhand AS instock,
       lp.DateOrdered AS lpdate,
       lp.QtyOrdered AS lpqty,
       lp.PriceActual AS lprate,
       l.Description AS remarks
FROM XX_Requisition r
LEFT JOIN XX_Requisition_Line l ON l.XX_Requisition_ID = r.XX_Requisition_ID
LEFT JOIN M_Product p ON p.M_Product_ID = l.M_Product_ID
LEFT JOIN C_UOM uom ON uom.C_UOM_ID = p.C_UOM_ID
LEFT JOIN AD_Org o ON o.AD_Org_ID = r.AD_Org_ID
LEFT JOIN M_Warehouse w ON w.M_Warehouse_ID = r.M_Warehouse_ID
LEFT JOIN AD_User u ON u.AD_User_ID = r.CreatedBy
LEFT JOIN AD_Ref_List rl ON rl.AD_Reference_ID = 131 AND rl.Value = r.DocStatus
LEFT JOIN LATERAL (
    SELECT COALESCE(SUM(s.QtyOnHand),0) AS qtyonhand
    FROM M_StorageOnHand s
    JOIN M_Locator lc ON lc.M_Locator_ID = s.M_Locator_ID
    WHERE s.M_Product_ID = l.M_Product_ID
      AND lc.M_Warehouse_ID = r.M_Warehouse_ID) st ON true
LEFT JOIN LATERAL (
    SELECT o2.DateOrdered, ol.QtyOrdered, ol.PriceActual
    FROM C_OrderLine ol
    JOIN C_Order o2 ON o2.C_Order_ID = ol.C_Order_ID
    WHERE ol.M_Product_ID = l.M_Product_ID
      AND o2.IsSOTrx = 'N'
      AND o2.DocStatus IN ('CO','CL')
    ORDER BY o2.DateOrdered DESC, ol.C_OrderLine_ID DESC
    LIMIT 1) lp ON true
WHERE r.XX_Requisition_ID = $P{RECORD_ID}
ORDER BY l.Line]]>
	</queryString>

	<field name="documentno" class="java.lang.String"/>
	<field name="datedoc" class="java.sql.Timestamp"/>
	<field name="daterequired" class="java.sql.Timestamp"/>
	<field name="note" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="department" class="java.lang.String"/>
	<field name="purchasetype" class="java.lang.String"/>
	<field name="deliverylocation" class="java.lang.String"/>
	<field name="preparedby" class="java.lang.String"/>
	<field name="preparedtitle" class="java.lang.String"/>
	<field name="createdts" class="java.sql.Timestamp"/>
	<field name="linenum" class="java.lang.Integer"/>
	<field name="itemcode" class="java.lang.String"/>
	<field name="itemname" class="java.lang.String"/>
	<field name="uom" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="instock" class="java.math.BigDecimal"/>
	<field name="lpdate" class="java.sql.Timestamp"/>
	<field name="lpqty" class="java.math.BigDecimal"/>
	<field name="lprate" class="java.math.BigDecimal"/>
	<field name="remarks" class="java.lang.String"/>

