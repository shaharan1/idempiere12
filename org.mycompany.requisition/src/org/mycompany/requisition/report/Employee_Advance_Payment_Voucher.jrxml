      <staticText><reportElement mode="Opaque" x="0" y="0" width="35" height="22" backcolor="#F0F0F0"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[SL. No]]></text></staticText>
      <staticText><reportElement mode="Opaque" x="35" y="0" width="60" height="22" backcolor="#F0F0F0"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Code]]></text></staticText>
      <staticText><reportElement mode="Opaque" x="95" y="0" width="170" height="22" backcolor="#F0F0F0"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Charge]]></text></staticText>
      <staticText><reportElement mode="Opaque" x="265" y="0" width="90" height="22" backcolor="#F0F0F0"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Segment]]></text></staticText>
      <staticText><reportElement mode="Opaque" x="355" y="0" width="100" height="22" backcolor="#F0F0F0"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Remark]]></text></staticText>
      <staticText><reportElement mode="Opaque" x="455" y="0" width="100" height="22" backcolor="#F0F0F0"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Amount (BDT)]]></text></staticText>
    </band>
  </columnHeader>

  <!-- ===== DETAIL ===== -->
  <detail>
    <band height="20">
      <textField><reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="35" height="20"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{line_no}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="35" y="0" width="60" height="20"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{charge_code}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement stretchType="RelativeToBandHeight" x="95" y="0" width="170" height="20"/><box leftPadding="3"><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{charge_name}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement stretchType="RelativeToBandHeight" x="265" y="0" width="90" height="20"/><box leftPadding="3"><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{segment}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement stretchType="RelativeToBandHeight" x="355" y="0" width="100" height="20"/><box leftPadding="3"><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{remark}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00"><reportElement stretchType="RelativeToBandHeight" x="455" y="0" width="100" height="20"/><box rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{line_amount}]]></textFieldExpression></textField>
    </band>
