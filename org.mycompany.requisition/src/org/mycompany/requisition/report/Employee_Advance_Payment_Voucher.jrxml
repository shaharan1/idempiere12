      <textField pattern="#,##0.00"><reportElement x="455" y="0" width="100" height="20"/><box rightPadding="3"><pen lineWidth="0.5"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{total_amount}]]></textFieldExpression></textField>

      <staticText><reportElement x="0" y="32" width="90" height="18"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Amount In Words]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement x="90" y="32" width="465" height="18"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[": " + $F{amount_words}]]></textFieldExpression></textField>

      <staticText><reportElement x="0" y="54" width="90" height="18"/><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement x="90" y="54" width="465" height="18"/><textElement verticalAlignment="Top"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[": " + ($F{description} == null ? "" : $F{description})]]></textFieldExpression></textField>
    </band>
  </summary>

