      <textField isBlankWhenNull="true"><reportElement x="140" y="0" width="135" height="14"/><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{checked_by}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement x="140" y="14" width="135" height="14"/><box><bottomPen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement><textFieldExpression><![CDATA[$F{checked_at}]]></textFieldExpression></textField>
