	private static final String BTN_PRIMARY = "background:#2563eb;color:#fff;border:0;border-radius:6px;"
			+ "padding:8px 20px;font-weight:600;cursor:pointer;";
	private static final String BTN_GHOST = "background:#fff;color:#374151;border:1px solid #d1d5db;"
			+ "border-radius:6px;padding:8px 20px;font-weight:600;cursor:pointer;";

	// banner
	private final Label orgLabel = new Label();
	private final Label deptLabel = new Label();

	// selection
	private final Datebox dateBox = new Datebox();
	private final Combobox empCombo = new Combobox();

	// profile
	private final Label avatarLabel = new Label("?");
	private final Label nameLabel = new Label("No employee selected");
	private final Label codeLabel = new Label("Search an employee to load the profile");
	private final Label desigLabel = new Label("-");
	private final Label empDeptLabel = new Label("-");
	private final Label sectionLabel = new Label("-");
	private final Label joinLabel = new Label("-");

	// line entry
	private final Listbox segmentList = new Listbox();
	private final Listbox chargeList = new Listbox();
	private final Textbox remarkBox = new Textbox();
	private final Decimalbox amountBox = new Decimalbox();
	private final Button addBtn = new Button("+ Add");

	// list + footer
	private final Listbox lineList = new Listbox();
	private final Label countLabel = new Label("0 line(s)");
	private final Label totalLabel = new Label("0.00");
	private final Button okBtn = new Button("Create AP Invoice");
	private final Button cancelBtn = new Button("Close");

	private int selectedEmpId = 0;

	@Override
	protected void initForm() {
		try {
			buildUI();
			loadDefaults();
		} catch (Exception e) {
			log.log(Level.SEVERE, e.getMessage(), e);
			notify(e, "error");
		}
	}

	// =================================================================== UI

	private void buildUI() {
		Div root = div("background:#f3f4f6;padding:16px;");
		appendChild(root);

		// ---------- banner
		Div banner = div("background:linear-gradient(90deg,#1e3a8a,#2563eb);border-radius:10px;padding:16px 20px;"
				+ "display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;");
		Div titles = div("");
		Label t = new Label("Employee Advance Payment");
		t.setStyle("font-size:20px;font-weight:700;color:#fff;display:block;");
		Label st = new Label("Creates an AP Invoice with charge lines");
		st.setStyle("font-size:12px;color:#dbeafe;display:block;");
		titles.appendChild(t);
		titles.appendChild(st);
		Div pills = div("display:flex;gap:8px;");
		String pill = "background:rgba(255,255,255,.18);color:#fff;padding:4px 12px;border-radius:999px;font-size:12px;";
		orgLabel.setStyle(pill);
		deptLabel.setStyle(pill);
		pills.appendChild(orgLabel);
		pills.appendChild(deptLabel);
		banner.appendChild(titles);
		banner.appendChild(pills);
		root.appendChild(banner);

		// ---------- selection + profile
		Div row = div("display:flex;gap:16px;margin-top:16px;flex-wrap:wrap;");
		root.appendChild(row);

		Div sel = card("Employee Selection");
		sel.setStyle(CARD + "flex:1;min-width:300px;");
		dateBox.setFormat("dd/MM/yyyy");
		dateBox.setWidth("100%");
		empCombo.setAutodrop(true);
		empCombo.setButtonVisible(true);
		empCombo.setPlaceholder("Type employee ID or name...");
		empCombo.setWidth("100%");
		empCombo.addEventListener(Events.ON_CHANGING, this);
		empCombo.addEventListener(Events.ON_SELECT, this);
		sel.appendChild(field("Date *", dateBox, "none"));
		sel.appendChild(spacer(10));
		sel.appendChild(field("Employee ID / Name *", empCombo, "none"));
		row.appendChild(sel);

		Div prof = card("Employee Profile");
		prof.setStyle(CARD + "flex:2;min-width:420px;");
		Div who = div("display:flex;gap:14px;align-items:center;");
		Div avatar = div("width:56px;height:56px;border-radius:50%;background:#dbeafe;color:#1d4ed8;font-weight:700;"
				+ "font-size:20px;display:flex;align-items:center;justify-content:center;flex:none;");
		avatarLabel.setStyle("color:#1d4ed8;font-weight:700;font-size:20px;");
		avatar.appendChild(avatarLabel);
		Div ident = div("");
		nameLabel.setStyle("font-size:16px;font-weight:700;color:#111827;display:block;");
		codeLabel.setStyle("font-size:12px;color:#6b7280;display:block;");
		ident.appendChild(nameLabel);
		ident.appendChild(codeLabel);
		who.appendChild(avatar);
		who.appendChild(ident);
		prof.appendChild(who);
		Div tiles = div("display:flex;gap:28px;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px solid #f3f4f6;");
		tiles.appendChild(tile("Designation", desigLabel));
		tiles.appendChild(tile("Department", empDeptLabel));
		tiles.appendChild(tile("Section", sectionLabel));
		tiles.appendChild(tile("Date of Join", joinLabel));
		prof.appendChild(tiles);
		row.appendChild(prof);

		// ---------- lines
		Div lines = card("Advance Lines");
		lines.setStyle(CARD + "margin-top:16px;");
		segmentList.setMold("select");
		segmentList.setWidth("100%");
		chargeList.setMold("select");
		chargeList.setWidth("100%");
		remarkBox.setPlaceholder("Remark");
		remarkBox.setWidth("100%");
		amountBox.setFormat("#,##0.00");
		amountBox.setPlaceholder("0.00");
		amountBox.setWidth("100%");
		amountBox.addEventListener(Events.ON_OK, this); // Enter = Add
		addBtn.setStyle(BTN_PRIMARY);
		addBtn.addEventListener(Events.ON_CLICK, this);

		Div entry = div("display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;");
		entry.appendChild(field("Segment", segmentList, "1.2 1 160px"));
		entry.appendChild(field("Charge *", chargeList, "1.6 1 200px"));
		entry.appendChild(field("Remark", remarkBox, "2 1 200px"));
		entry.appendChild(field("Amount *", amountBox, "1 1 130px"));
		entry.appendChild(addBtn);
