		Label tc = new Label("GRAND TOTAL");
		tc.setStyle(CAP + "margin-bottom:0;");
		totalLabel.setStyle("font-size:24px;font-weight:700;color:#1e3a8a;display:block;");
		tot.appendChild(tc);
		tot.appendChild(totalLabel);
		okBtn.setStyle(BTN_PRIMARY);
		cancelBtn.setStyle(BTN_GHOST);
		okBtn.addEventListener(Events.ON_CLICK, this);
		cancelBtn.addEventListener(Events.ON_CLICK, this);
		right.appendChild(tot);
		right.appendChild(cancelBtn);
		right.appendChild(okBtn);
		foot.appendChild(countLabel);
		foot.appendChild(right);
		root.appendChild(foot);
	}

	private Div div(String style) {
		Div d = new Div();
		if (style != null && !style.isEmpty())
			d.setStyle(style);
		return d;
	}

	private Div spacer(int px) {
		return div("height:" + px + "px;");
	}

	private Div card(String title) {
		Div c = div(CARD);
		Label l = new Label(title);
		l.setStyle(CARD_TITLE);
		c.appendChild(l);
		return c;
	}

	private Div field(String caption, Component input, String flex) {
		Div d = div("display:flex;flex-direction:column;min-width:120px;" + (flex.equals("none") ? "" : "flex:" + flex + ";"));
		Label l = new Label(caption);
		l.setStyle(CAP);
		d.appendChild(l);
		d.appendChild(input);
		return d;
	}

	private Div tile(String caption, Label value) {
		Div d = div("min-width:110px;");
		Label c = new Label(caption);
		c.setStyle(CAP + "margin-bottom:2px;");
		value.setStyle("font-size:14px;font-weight:600;color:#111827;display:block;");
		d.appendChild(c);
		d.appendChild(value);
		return d;
	}

	private Listheader header(String text, String width) {
		Listheader h = new Listheader(text);
		if (width != null)
			h.setWidth(width);
		return h;
	}

	// ============================================================== defaults

	private void loadDefaults() {
		orgLabel.setValue("Org: " + EmpAdvanceService.getOrgName(Env.getCtx()));
		deptLabel.setValue("Dept: " + EmpAdvanceService.getLoginUserDepartment(Env.getCtx()));
		dateBox.setValue(new Date());

		try {
			EmpAdvanceService.ensureDefaultCharge(Env.getCtx(), DEFAULT_CHARGE);
		} catch (Exception e) {
			log.log(Level.WARNING, "Default charge not created: " + e.getMessage());
		}
		fill(segmentList, EmpAdvanceService.getSegments(Env.getCtx()), true, null);
		fill(chargeList, EmpAdvanceService.getCharges(Env.getCtx()), false, DEFAULT_CHARGE);
		reloadEmployees("");
	}

	private void fill(Listbox lb, List<KeyNamePair> data, boolean blankFirst, String defaultPrefix) {
		while (lb.getItemCount() > 0)
			lb.removeItemAt(0);
		if (blankFirst)
			lb.appendChild(new Listitem("", Integer.valueOf(0)));
		Listitem def = null;
		for (KeyNamePair kp : data) {
			Listitem li = new Listitem(kp.getName(), Integer.valueOf(kp.getKey()));
			lb.appendChild(li);
			if (def == null && defaultPrefix != null && kp.getName().startsWith(defaultPrefix))
				def = li;
		}
		if (def != null)
			lb.setSelectedItem(def);
		else if (lb.getItemCount() > 0)
			lb.setSelectedIndex(0);
	}

	// ================================================================ events

	@Override
	public void onEvent(Event e) {
		Component c = e.getTarget();
		try {
			if (c == empCombo && Events.ON_CHANGING.equals(e.getName())) {
				reloadEmployees(((InputEvent) e).getValue());
			} else if (c == empCombo && Events.ON_SELECT.equals(e.getName())) {
				onEmployeeSelected();
			} else if (c == addBtn || (c == amountBox && Events.ON_OK.equals(e.getName()))) {
				addLine();
			} else if (c == okBtn) {
				save();
			} else if (c == cancelBtn) {
				SessionManager.getAppDesktop().closeActiveWindow();
			}
		} catch (Exception ex) {
			log.log(Level.SEVERE, ex.getMessage(), ex);
			notify(ex, "error");
		}
	}

	private void reloadEmployees(String text) {
		empCombo.getChildren().clear();
		for (KeyNamePair kp : EmpAdvanceService.searchEmployees(Env.getCtx(), text)) {
			Comboitem ci = new Comboitem(kp.getName());
			ci.setValue(Integer.valueOf(kp.getKey()));
			empCombo.appendChild(ci);
		}
	}

	private void onEmployeeSelected() {
		Comboitem ci = empCombo.getSelectedItem();
		if (ci == null)
			return;
		selectedEmpId = (Integer) ci.getValue();
		EmpAdvanceService.EmpInfo e = EmpAdvanceService.getEmployee(selectedEmpId);
		nameLabel.setValue(nz(e.name));
		codeLabel.setValue("ID: " + nz(e.code));
		avatarLabel.setValue(initials(e.name));
		desigLabel.setValue(dash(e.designation));
		empDeptLabel.setValue(dash(e.department));
		sectionLabel.setValue(dash(e.section));
		joinLabel.setValue(e.joinDate == null ? "-" : new SimpleDateFormat("dd/MM/yyyy").format(e.joinDate));
	}

	private void addLine() {
		if (selectedEmpId <= 0)
			throw new IllegalStateException("Please select an Employee first");
		Listitem chg = chargeList.getSelectedItem();
		if (chg == null || (Integer) chg.getValue() <= 0)
			throw new IllegalStateException("Charge is required");
		BigDecimal amt = amountBox.getValue();
		if (amt == null || amt.signum() <= 0)
			throw new IllegalStateException("Amount must be greater than zero");

		Listitem seg = segmentList.getSelectedItem();
		int segId = seg == null ? 0 : (Integer) seg.getValue();
		String segName = seg == null ? "" : seg.getLabel();

		AdvanceLine line = new AdvanceLine(segId, segName, (Integer) chg.getValue(), chg.getLabel(),
				remarkBox.getValue(), amt);

		final Listitem li = new Listitem();
		li.setValue(line);
		li.appendChild(new Listcell(String.valueOf(lineList.getItemCount() + 1)));
		li.appendChild(new Listcell(segName));
		li.appendChild(new Listcell(line.chargeName));
		li.appendChild(new Listcell(nz(line.remark)));
		Listcell ac = new Listcell(AMT_FMT.format(amt));
		ac.setStyle("text-align:right;font-weight:600;");
		li.appendChild(ac);

		Button del = new Button("\u2715");
		del.setStyle("background:#fee2e2;color:#b91c1c;border:0;border-radius:4px;padding:2px 8px;cursor:pointer;");
		del.addEventListener(Events.ON_CLICK, new EventListener<Event>() {
			@Override
			public void onEvent(Event event) {
				lineList.removeChild(li);
				renumber();
				refreshTotal();
			}
		});
		Listcell dc = new Listcell();
		dc.appendChild(del);
		li.appendChild(dc);
		lineList.appendChild(li);

		remarkBox.setValue("");
		amountBox.setValue((BigDecimal) null);
		refreshTotal();
	}

	private void renumber() {
		int n = 1;
		for (Listitem item : lineList.getItems())
			((Listcell) item.getFirstChild()).setLabel(String.valueOf(n++));
	}

	private List<AdvanceLine> collectLines() {
		List<AdvanceLine> lines = new ArrayList<>();
		for (Listitem li : lineList.getItems())
			lines.add((AdvanceLine) li.getValue());
		return lines;
	}

	private void refreshTotal() {
		List<AdvanceLine> l = collectLines();
		totalLabel.setValue(AMT_FMT.format(EmpAdvanceService.sum(l)));
		countLabel.setValue(l.size() + " line(s)");
	}

	private void save() {
		if (dateBox.getValue() == null)
			throw new IllegalStateException("Date is required");
		if (selectedEmpId <= 0)
			throw new IllegalStateException("Employee is required");
		List<AdvanceLine> lines = collectLines();
		if (lines.isEmpty())
			throw new IllegalStateException("Add at least one line");

		String docNo = EmpAdvanceService.createApInvoice(Env.getCtx(), selectedEmpId,
				new Timestamp(dateBox.getValue().getTime()), lines);

		Clients.showNotification("AP Invoice created: " + docNo, "info", null, "middle_center", 4000);
		resetForm();
	}

	private void resetForm() {
		selectedEmpId = 0;
		empCombo.setValue("");
		avatarLabel.setValue("?");
		nameLabel.setValue("No employee selected");
		codeLabel.setValue("Search an employee to load the profile");
		desigLabel.setValue("-");
		empDeptLabel.setValue("-");
		sectionLabel.setValue("-");
		joinLabel.setValue("-");
		remarkBox.setValue("");
		amountBox.setValue((BigDecimal) null);
		while (lineList.getItemCount() > 0)
			lineList.removeItemAt(0);
		refreshTotal();
	}

	// ================================================================ helpers

	private void notify(Exception e, String type) {
		String msg = e.getMessage() == null ? e.toString() : e.getMessage();
		Clients.showNotification(msg, type, null, "middle_center", 5000);
	}

	private static String initials(String name) {
		if (name == null || name.trim().isEmpty())
			return "?";
		String[] p = name.trim().split("\\s+");
		String s = p[0].substring(0, 1);
		if (p.length > 1)
			s += p[p.length - 1].substring(0, 1);
		return s.toUpperCase();
	}

	private static String nz(String s) {
		return s == null ? "" : s;
	}

	private static String dash(String s) {
		return (s == null || s.trim().isEmpty()) ? "-" : s;
	}
}
