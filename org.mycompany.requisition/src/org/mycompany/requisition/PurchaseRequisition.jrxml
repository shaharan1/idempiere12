<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PurchaseRequisition" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
<parameter name="RECORD_ID" class="java.lang.Integer"/>
<parameter name="LOGO_LEFT" class="java.lang.String"><defaultValueExpression><![CDATA["C:/jasper/logo_left.png"]]></defaultValueExpression></parameter>
<parameter name="LOGO_RIGHT" class="java.lang.String"><defaultValueExpression><![CDATA["C:/jasper/logo_right.png"]]></defaultValueExpression></parameter>
<queryString><![CDATA[SELECT r.documentno, r.datedoc, r.daterequired,
 (SELECT rl.name FROM ad_ref_list rl WHERE rl.ad_reference_id=131 AND rl.value=r.docstatus) AS status,
 r.description AS note,
 w.name AS delivery_location,
 dt.name AS purchase_type,
 ''::varchar AS department,
 u.name AS prepared_by, r.created AS prepared_date,
 l.line, p.value AS item_code, p.name AS item_name, uom.uomsymbol AS uom,
 l.qty, l.description AS remarks,
 COALESCE((SELECT SUM(s.qtyonhand) FROM m_storageonhand s WHERE s.m_product_id=l.m_product_id),0) AS in_stock
FROM m_requisition r
JOIN m_requisitionline l ON l.m_requisition_id=r.m_requisition_id
LEFT JOIN m_warehouse w ON w.m_warehouse_id=r.m_warehouse_id
LEFT JOIN c_doctype dt ON dt.c_doctype_id=r.c_doctype_id
LEFT JOIN ad_user u ON u.ad_user_id=r.createdby
LEFT JOIN m_product p ON p.m_product_id=l.m_product_id
LEFT JOIN c_uom uom ON uom.c_uom_id=p.c_uom_id
WHERE r.m_requisition_id=$P{RECORD_ID}
ORDER BY l.line]]></queryString>
<field name="documentno" class="java.lang.String"/>
<field name="datedoc" class="java.sql.Timestamp"/>
<field name="daterequired" class="java.sql.Timestamp"/>
<field name="status" class="java.lang.String"/>
<field name="note" class="java.lang.String"/>
<field name="delivery_location" class="java.lang.String"/>
<field name="purchase_type" class="java.lang.String"/>
<field name="department" class="java.lang.String"/>
<field name="prepared_by" class="java.lang.String"/>
<field name="prepared_date" class="java.sql.Timestamp"/>
<field name="line" class="java.math.BigDecimal"/>
<field name="item_code" class="java.lang.String"/>
<field name="item_name" class="java.lang.String"/>
<field name="uom" class="java.lang.String"/>
<field name="qty" class="java.math.BigDecimal"/>
<field name="remarks" class="java.lang.String"/>
<field name="in_stock" class="java.math.BigDecimal"/>
