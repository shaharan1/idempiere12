<field name="priority" class="java.lang.String"/>
<field name="prepared_by" class="java.lang.String"/>
<field name="prepared_date" class="java.sql.Timestamp"/>
<field name="item_code" class="java.lang.String"/>
<field name="item_name" class="java.lang.String"/>
<field name="uom" class="java.lang.String"/>
<field name="qty" class="java.math.BigDecimal"/>
<field name="in_stock" class="java.math.BigDecimal"/>
<field name="line_date" class="java.sql.Timestamp"/>
<field name="remarks" class="java.lang.String"/>
<field name="lp_vendor" class="java.lang.String"/>
<field name="lp_date" class="java.sql.Timestamp"/>
<field name="lp_qty" class="java.math.BigDecimal"/>
<field name="lp_rate" class="java.math.BigDecimal"/>
<field name="checked_by" class="java.lang.String"/>
<field name="checked_date" class="java.sql.Timestamp"/>
<field name="recommended_by" class="java.lang.String"/>
<field name="recommended_date" class="java.sql.Timestamp"/>
<field name="authorized_by" class="java.lang.String"/>
<field name="authorized_date" class="java.sql.Timestamp"/>
<field name="approved_by" class="java.lang.String"/>
<field name="approved_date" class="java.sql.Timestamp"/>
<variable name="TOTAL_QTY" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{qty}]]></variableExpression></variable>
