<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PurchaseRequisition" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="28" bottomMargin="28">
<!--
  Purchase Requisition (same fields as the Requisition Form).
  Header : PR No, PR Date (Document Date), Required Date, Organization, Requisition Type (document type),
           Priority, Segment, Department (taken from the first requisition line), Location, Warehouse,
           Prepared by (user), Status.
  Lines  : S/N, Product Code, Product Name, UOM, Qty, Available (stock of the requisition warehouse),
           Date Required (line), Remarks = Product Specification (line description).
  Note   : the requisition Description.
  Parameters: RECORD_ID (M_Requisition_ID), LOGO_LEFT, LOGO_RIGHT (png path, blank when missing).
  Needs the columns of db/16_requisition_entry_form.sql.
-->
<style name="Zebra" mode="Opaque" backcolor="#FFFFFF"><conditionalStyle><conditionExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></conditionExpression><style backcolor="#F7F9FC"/></conditionalStyle></style>
<parameter name="RECORD_ID" class="java.lang.Integer"/>
<parameter name="LOGO_LEFT" class="java.lang.String"><defaultValueExpression><![CDATA["C:/jasper/logo_left.png"]]></defaultValueExpression></parameter>
<parameter name="LOGO_RIGHT" class="java.lang.String"><defaultValueExpression><![CDATA["C:/jasper/logo_right.png"]]></defaultValueExpression></parameter>
<queryString><![CDATA[SELECT r.documentno, r.datedoc, r.daterequired,
 (SELECT sl.name FROM ad_ref_list sl WHERE sl.ad_reference_id=131 AND sl.value=r.docstatus LIMIT 1) AS status,
 r.description AS note,
 o.name AS organization,
 (SELECT g.name FROM ad_ref_list g JOIN ad_reference gr ON gr.ad_reference_id=g.ad_reference_id
   WHERE gr.name='XX Requisition Segment' AND g.value=(SELECT x.xx_segment FROM m_requisitionline x
     WHERE x.m_requisition_id=r.m_requisition_id AND x.isactive='Y' AND x.xx_segment IS NOT NULL
     ORDER BY x.line, x.m_requisitionline_id LIMIT 1) LIMIT 1) AS segment,
 (SELECT a.name FROM c_activity a WHERE a.c_activity_id=(SELECT x.xx_department_id FROM m_requisitionline x
     WHERE x.m_requisition_id=r.m_requisition_id AND x.isactive='Y' AND x.xx_department_id IS NOT NULL
     ORDER BY x.line, x.m_requisitionline_id LIMIT 1)) AS department,
 (SELECT g.name FROM ad_ref_list g JOIN ad_reference gr ON gr.ad_reference_id=g.ad_reference_id
   WHERE gr.name='XX Requisition Location' AND g.value=r.xx_location LIMIT 1) AS location,
 w.name AS warehouse,
 dt.name AS req_type,
 (SELECT pl.name FROM ad_ref_list pl WHERE pl.ad_reference_id=154 AND pl.value=r.priorityrule LIMIT 1) AS priority,
 u.name AS prepared_by, r.created AS prepared_date,
 p.value AS item_code, p.name AS item_name, COALESCE(uom.uomsymbol, uom.name) AS uom,
 l.qty,
 COALESCE((SELECT SUM(s.qtyonhand) FROM m_storageonhand s JOIN m_locator lo ON lo.m_locator_id=s.m_locator_id
   WHERE s.m_product_id=l.m_product_id AND (r.m_warehouse_id IS NULL OR lo.m_warehouse_id=r.m_warehouse_id)),0) AS in_stock,
 COALESCE(l.xx_daterequired, r.daterequired) AS line_date,
 l.description AS remarks,
 chk.nm AS checked_by, chk.dt AS checked_date, rec.nm AS recommended_by, rec.dt AS recommended_date,
 aut.nm AS authorized_by, aut.dt AS authorized_date, app.nm AS approved_by, app.dt AS approved_date
FROM m_requisition r
JOIN m_requisitionline l ON l.m_requisition_id=r.m_requisition_id AND l.isactive='Y'
LEFT JOIN ad_org o ON o.ad_org_id=r.ad_org_id
LEFT JOIN m_warehouse w ON w.m_warehouse_id=r.m_warehouse_id
LEFT JOIN c_doctype dt ON dt.c_doctype_id=r.c_doctype_id
LEFT JOIN ad_user u ON u.ad_user_id=COALESCE(r.ad_user_id, r.createdby)
LEFT JOIN m_product p ON p.m_product_id=l.m_product_id
LEFT JOIN c_uom uom ON uom.c_uom_id=p.c_uom_id
LEFT JOIN LATERAL (SELECT au.name AS nm, a.updated AS dt FROM ad_wf_activity a
   JOIN ad_wf_node n ON n.ad_wf_node_id=a.ad_wf_node_id
   JOIN ad_table t ON t.ad_table_id=a.ad_table_id AND t.tablename='M_Requisition'
   LEFT JOIN ad_user au ON au.ad_user_id=a.updatedby
   WHERE a.record_id=r.m_requisition_id AND a.wfstate='CC' AND n.name ILIKE '%check%'
   ORDER BY a.updated DESC LIMIT 1) chk ON true
LEFT JOIN LATERAL (SELECT au.name AS nm, a.updated AS dt FROM ad_wf_activity a
   JOIN ad_wf_node n ON n.ad_wf_node_id=a.ad_wf_node_id
   JOIN ad_table t ON t.ad_table_id=a.ad_table_id AND t.tablename='M_Requisition'
   LEFT JOIN ad_user au ON au.ad_user_id=a.updatedby
   WHERE a.record_id=r.m_requisition_id AND a.wfstate='CC' AND n.name ILIKE '%recommend%'
   ORDER BY a.updated DESC LIMIT 1) rec ON true
LEFT JOIN LATERAL (SELECT au.name AS nm, a.updated AS dt FROM ad_wf_activity a
   JOIN ad_wf_node n ON n.ad_wf_node_id=a.ad_wf_node_id
   JOIN ad_table t ON t.ad_table_id=a.ad_table_id AND t.tablename='M_Requisition'
   LEFT JOIN ad_user au ON au.ad_user_id=a.updatedby
   WHERE a.record_id=r.m_requisition_id AND a.wfstate='CC' AND n.name ILIKE '%author%'
   ORDER BY a.updated DESC LIMIT 1) aut ON true
LEFT JOIN LATERAL (SELECT au.name AS nm, a.updated AS dt FROM ad_wf_activity a
   JOIN ad_wf_node n ON n.ad_wf_node_id=a.ad_wf_node_id
   JOIN ad_table t ON t.ad_table_id=a.ad_table_id AND t.tablename='M_Requisition'
   LEFT JOIN ad_user au ON au.ad_user_id=a.updatedby
   WHERE a.record_id=r.m_requisition_id AND a.wfstate='CC' AND n.name ILIKE '%approv%'
   ORDER BY a.updated DESC LIMIT 1) app ON true
WHERE r.m_requisition_id=$P{RECORD_ID}
ORDER BY l.line, l.m_requisitionline_id]]></queryString>
