<?xml version="1.0" encoding="UTF-8"?>
<zk>
<borderlayout id="layout" sclass="login-window">
	<center border="none" autoscroll="true" style="background-color: transparent;">
		<vbox pack="center" align="center" style="background-color: transparent;" hflex="1" vflex="1">
			<window use="org.adempiere.webui.window.LoginWindow" id="loginWindow"/>
		</vbox>
	</center>
	<west id="west" width="0px" border="none" splittable="false" collapsible="false"
      style="background-color: transparent; border: none;">
    <div/>
</west>
<east id="east" width="0px" border="none" splittable="false" collapsible="false"
      style="background-color: transparent; border: none;">
    <div/>
</east>
	<north sclass="login-north-panel">
		<include src="~./theme/iceblue_c/zul/login/login-top.zul"/>
	</north>
	<south sclass="login-south-panel">
		<include src="~./theme/iceblue_c/zul/login/login-bottom.zul"/>
	</south>
</borderlayout>
</zk>